# Spirit Home Health Care — clean URLs (no .html)
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On
RewriteBase /

# Send index.html (or /index) to the root
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]

# Redirect any /page.html to the clean /page (301)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Internally serve /page from /page.html (no visible extension)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
